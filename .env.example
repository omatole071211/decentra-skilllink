# Database Configuration
# SkillLink supports MySQL via Drizzle ORM.
# If DATABASE_URL is not set or MySQL is unreachable, it automatically uses persistent local storage (.data/db.json).
# DATABASE_URL=mysql://root:password@localhost:3306/skilllink

# Session Secret (used for signing secure JWT auth tokens)
SESSION_SECRET=skilllink-super-secret-jwt-key-2026-campus-exchange

# Server Port
PORT=3000
